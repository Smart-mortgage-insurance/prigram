{
  "manifest_version": 3,
  "name": "נטגרם – התראות על עדכונים",
  "short_name": "נטגרם",
  "description": "מקפיץ חלונית בכל פעם שעולה עדכון חדש בנטגרם, ומציג את העדכונים האחרונים בלחיצה.",
  "version": "1.0.0",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "נטגרם" },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": ["https://smart-mortgage-insurance.github.io/prigram/*"]
}
